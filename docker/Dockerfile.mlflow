# MLflow + драйвер Postgres.
#
# Официальный образ ghcr.io/mlflow/mlflow идёт без psycopg2, поэтому
# `--backend-store-uri postgresql://...` в нём падает на старте с
# ModuleNotFoundError. Ставим драйвер сами — иначе пришлось бы держать
# метаданные экспериментов в sqlite внутри контейнера, что для «прод-подобного»
# окружения неправильно: база должна переживать пересоздание контейнера.

# Версия сервера обязана совпадать с версией клиента (см. pyproject.toml).
# Клиент 3.x обращается к эндпоинтам, которых в сервере 2.x нет, и логирование
# модели падает с 404 — при этом сам эксперимент создаётся, так что ошибка
# выглядит как «частично сработало» и ищется долго.
FROM ghcr.io/mlflow/mlflow:v3.15.1

RUN pip install --no-cache-dir psycopg2-binary==2.9.9

EXPOSE 5000
